--*** Page graphics and repeated channel layouts ***
function SetupLayout(layout, graphics)
  table.insert(graphics, {
    Type = "GroupBox",
    Position = { 5, 130 },
    Size = { 390, 430 },
    Fill = PanelGray,
    StrokeWidth = 0,
  })
  table.insert(graphics, {
    Type = "GroupBox",
    Position = { 5, 570 },
    Size = { 390, 155 },
    Fill = PanelGray,
    StrokeWidth = 0,
  })
  table.insert(graphics, {
    Type = "Header",
    Text = "Connection",
    Position = { 35, 140 },
    Size = { 330, 16 },
    Color = Black,
    FontSize = 14,
  })
  table.insert(graphics, {
    Type = "Header",
    Text = "Last Will (optional)",
    Position = { 35, 580 },
    Size = { 330, 16 },
    Color = Black,
    FontSize = 14,
  })
  local rows = {
    { "IPAddress", "Broker address", "Text", 165 },
    { "Port", "Port", "Text", 190 },
    { "ClientId", "Unique client ID", "Text", 215 },
    { "Username", "Username", "Text", 240 },
    { "Password", "Password", "Text", 265 },
    { "Tls", "Use TLS", "Button", 290 },
    { "CaCertificate", "CA certificate (PEM)", "Text", 315 },
    { "KeepAlive", "Keepalive (seconds)", "Text", 390 },
    { "Enable", "Enable connection", "Button", 415 },
    { "Reconnect", "Apply / reconnect", "Button", 440 },
    { "Connected", "Broker connected", "Led", 465 },
    { "Status", "Status", "Text", 490 },
    { "WillTopic", "Topic (blank disables)", "Text", 605 },
    { "WillPayload", "Payload", "Text", 630 },
    { "WillQos", "QoS", "ComboBox", 655 },
    { "WillRetain", "Retain", "Button", 680 },
  }
  for _, row in ipairs(rows) do
    local name, label, style, y = table.unpack(row)
    table.insert(graphics, {
      Type = "Label",
      Text = label,
      Position = { 15, y },
      Size = { 155, 20 },
      Color = Black,
      HTextAlign = "Right",
      FontSize = 13,
    })
    layout[name] = {
      Style = style,
      Position = { 180, y },
      Size = { 200, name == "CaCertificate" and 65 or 20 },
      PrettyName = "Setup~" .. label,
      FontSize = 13,
    }
    if style == "Button" then
      layout[name].ButtonStyle = name == "Reconnect" and "Trigger" or "Toggle"
      layout[name].Size = { 45, 20 }
      layout[name].Color = White
      layout[name].CornerRadius = 2
      layout[name].Margin = 2
    elseif style == "Led" then
      layout[name].Color = IndicatorGreen
      layout[name].Size = { 20, 20 }
    end
  end
  layout.Status.Size = { 200, 30 }
  layout.CaCertificate.WordWrap = true
  table.insert(graphics, {
    Type = "Label",
    Text = "Setup and subscription changes apply on reconnect.",
    Position = { 15, 525 },
    Size = { 370, 20 },
    Color = Black,
    FontSize = 11,
  })
end

