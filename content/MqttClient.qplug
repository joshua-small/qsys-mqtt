-- MQTT client candidate for Q-SYS 10.5. See the adjacent README for acceptance limits.
PluginInfo = {
  Name = "Utilities~MQTT Client",
  Version = "0.3.1.1",
  BuildVersion = "0.3.1.1",
  Id = "f622973c-31a1-4ab0-afd0-2fbb9a436eb3",
  Author = "Joshua Small",
  Manufacturer = "Generic",
  Model = "MQTT 3.1.1 / 5.0",
  Description = "MQTT 3.1.1 / 5.0 publish/subscribe, QoS 0/1 and clean sessions. Development candidate.",
}

--*** Native presentation constants ***
White = { 255, 255, 255 }
Black = { 0, 0, 0 }
PanelGray = { 230, 230, 230 }
ReadoutGray = { 194, 194, 194 }
OutlineGray = { 128, 128, 128 }
MqttPurple = { 102, 0, 102 }
IndicatorGreen = { 0, 159, 60 }
-- Supplied MQTT SVG, full 1100 x 280 viewBox and original #660066 colors.
MqttLogo =
  ""

--*** Reserved design-time functions ***
function GetColor(props)
  return MqttPurple
end

function GetPrettyName(props)
  return "MQTT Client " .. PluginInfo.Version
end

function GetProperties()
  return {
    {
      Name = "Channels",
      Type = "integer",
      Min = 1,
      Max = 8,
      Value = 2,
    },
    {
      Name = "MQTT Version",
      Type = "enum",
      Choices = { "3.1.1", "5.0" },
      Value = "3.1.1",
    },
    {
      Name = "Debug Print",
      Type = "enum",
      Choices = { "None", "Tx", "Rx", "Tx/Rx", "Function Calls", "All" },
      Value = "None",
    },
  }
end

function GetPages(props)
  local pages = { { name = "Setup" } }
  for index = 1, props.Channels.Value do
    table.insert(pages, { name = "Channel " .. index })
  end
  table.insert(pages, { name = "Certificates" })
  return pages
end

