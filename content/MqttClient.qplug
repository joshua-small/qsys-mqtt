function ChannelLayout(layout, graphics, channel)
  table.insert(graphics, {
    Type = "GroupBox",
    Position = { 5, 130 },
    Size = { 390, 185 },
    Fill = PanelGray,
    StrokeWidth = 0,
  })
  table.insert(graphics, {
