-- DISCONNECT reason codes
-- DOC: Table 3‑10 – Disconnect Reason Code values
local disconnect_rc = {
	[0x00] = "Normal disconnection",
	[0x04] = "Disconnect with Will Message",
	[0x80] = "Unspecified error",
	[0x81] = "Malformed Packet",
	[0x82] = "Protocol Error",
	[0x83] = "Implementation specific error",
	[0x87] = "Not authorized",
	[0x89] = "Server busy",
	[0x8B] = "Server shutting down",
	[0x8D] = "Keep Alive timeout",
	[0x8E] = "Session taken over",
	[0x8F] = "Topic Filter invalid",
	[0x90] = "Topic Name invalid",
	[0x93] = "Receive Maximum exceeded",
	[0x94] = "Topic Alias invalid",
	[0x95] = "Packet too large",
	[0x96] = "Message rate too high",
	[0x97] = "Quota exceeded",
	[0x98] = "Administrative action",
	[0x99] = "Payload format invalid",
	[0x9A] = "Retain not supported",
	[0x9B] = "QoS not supported",
	[0x9C] = "Use another server",
	[0x9D] = "Server moved",
	[0x9E] = "Shared Subscriptions not supported",
	[0x9F] = "Connection rate exceeded",
	[0xA0] = "Maximum connect time",
	[0xA1] = "Subscription Identifiers not supported",
	[0xA2] = "Wildcard Subscriptions not supported",
}
protocol5.disconnect_rc = disconnect_rc

--- Parsed DISCONNECT packet metatable
local disconnect_packet_mt = {
	__tostring = protocol.packet_tostring, -- packet-to-human-readable-string conversion metamethod using protocol.packet_tostring()
	reason_string = function(self) -- Returns reason string for the DISCONNECT packet according to its rc field
		local reason_string = disconnect_rc[self.rc]
		if not reason_string then
			reason_string = "Unknown: "..self.rc
		end
		return reason_string
	end,
}
disconnect_packet_mt.__index = disconnect_packet_mt
protocol5.disconnect_packet_mt = disconnect_packet_mt

-- Parse DISCONNECT packet, DOC: 3.14 DISCONNECT – Disconnect notification
local function parse_packet_disconnect(ptype, flags, input)
	-- DOC: 3.14.1 DISCONNECT Fixed Header
	if flags ~= 0 then -- Reserved
		return false, packet_type[ptype]..": unexpected flags value: "..flags
	end
	local read_data = input.read_func
	local packet = setmetatable({type=ptype, rc=0, properties={}, user_properties={}}, disconnect_packet_mt)
	if input.available > 0 then
		-- DOC: 3.14.2 DISCONNECT Variable Header
		-- DOC: 3.14.2.1 Disconnect Reason Code
		local rc, err = parse_uint8(read_data)
		if not rc then
			return false, packet_type[ptype]..": failed to parse rc: "..err
		end
		packet.rc = rc
		-- DOC: 3.14.2.2.1 If the Remaining Length is less than 2, a value of 0 is used
		if input.available > 0 then
			-- DOC: 3.14.2.2 DISCONNECT Properties
			local ok
			ok, err = parse_properties(ptype, read_data, input, packet)
			if not ok then
				return false, packet_type[ptype]..": failed to parse packet properties: "..err
			end
		end
	end
	return packet
end

-- Parse AUTH packet, DOC: 3.15 AUTH – Authentication exchange
local function parse_packet_auth(ptype, flags, input)
	-- DOC: 3.15.1 AUTH Fixed Header
	if flags ~= 0 then -- Reserved
		return false, packet_type[ptype]..": unexpected flags value: "..flags
	end
	local read_data = input.read_func
	-- DOC: 3.15.2.1 Authenticate Reason Code
	local packet = setmetatable({type=ptype, rc=0, properties={}, user_properties={}}, packet_mt)
	if input.available > 1 then
		-- DOC: 3.15.2 AUTH Variable Header
		local rc, err = parse_uint8(read_data)
		if not rc then
			return false, packet_type[ptype]..": failed to parse Authenticate Reason Code: "..err
		end
		packet.rc = rc
		-- DOC: 3.15.2.2 AUTH Properties
		local ok
		ok, err = parse_properties(ptype, read_data, input, packet)
		if not ok then
			return false, packet_type[ptype]..": failed to parse packet properties: "..err
		end
	end
	return packet
end

-- Parse packet using given read_func
-- Returns packet on success or false and error message on failure
function protocol5.parse_packet(read_func)
	local ptype, flags, input = start_parse_packet(read_func)
	if not ptype then
		return false, flags
	end
	local packet, err

	-- parse read data according type in fixed header
	if ptype == packet_type.CONNECT then			-- 1
		packet, err = parse_packet_connect_input(input, const_v50)
	elseif ptype == packet_type.CONNACK then		-- 2
		packet, err = parse_packet_connack(ptype, flags, input)
	elseif ptype == packet_type.PUBLISH then		-- 3
		packet, err = parse_packet_publish(ptype, flags, input)
	elseif ptype == packet_type.PUBACK then			-- 4
		packet, err = parse_packet_puback(ptype, flags, input)
	elseif ptype == packet_type.PUBREC then			-- 5
		packet, err = parse_packet_pubrec(ptype, flags, input)
	elseif ptype == packet_type.PUBREL then			-- 6
		packet, err = parse_packet_pubrel(ptype, flags, input)
	elseif ptype == packet_type.PUBCOMP then		-- 7
		packet, err = parse_packet_pubcomp(ptype, flags, input)
	elseif ptype == packet_type.SUBSCRIBE then		-- 8
		packet, err = parse_packet_subscribe(ptype, flags, input)
	elseif ptype == packet_type.SUBACK then			-- 9
		packet, err = parse_packet_suback(ptype, flags, input)
	elseif ptype == packet_type.UNSUBSCRIBE then	-- 10
		packet, err = parse_packet_unsubscribe(ptype, flags, input)
	elseif ptype == packet_type.UNSUBACK then		-- 11
		packet, err = parse_packet_unsuback(ptype, flags, input)
	elseif ptype == packet_type.PINGREQ then		-- 12
		packet, err = parse_packet_pingreq(ptype, flags, input)
	elseif ptype == packet_type.PINGRESP then		-- 13
		packet, err = parse_packet_pingresp(ptype, flags, input)
	elseif ptype == packet_type.DISCONNECT then		-- 14
		packet, err = parse_packet_disconnect(ptype, flags, input)
	elseif ptype == packet_type.AUTH then			-- 15
		packet, err = parse_packet_auth(ptype, flags, input)
	else
		return false, "unexpected packet type received: "..tostring(ptype)
	end
	if packet and input.available > 0 then
		return false, packet_type[ptype]..": extra data in remaining length left after packet parsing"
	end
	return packet, err
end

-- Continue parsing of the MQTT v5.0 CONNECT packet
-- Internally called from the protocol.parse_packet_connect_input() function
-- Returns packet on success or false and error message on failure
function protocol5._parse_packet_connect_continue(input, packet)
	local read_func = input.read_func
	local ok, client_id, err

	-- DOC: 3.1.2.11 CONNECT Properties
	ok, err = parse_properties(packet_type.CONNECT, read_func, input, packet)
	if not ok then
		return false, "CONNECT: failed to parse packet properties: "..err
	end

	-- DOC: 3.1.3 CONNECT Payload

	-- DOC: 3.1.3.1 Client Identifier (ClientID)
	client_id, err = parse_string(read_func)
	if not client_id then
		return false, "CONNECT: failed to parse client_id: "..err
	end
	packet.id = client_id

	local will = packet.will
	if will then
		-- DOC: 3.1.3.2 Will Properties
		ok, err = parse_properties("will", read_func, input, will)
		if not ok then
			return false, "CONNECT: failed to parse will message properties: "..err
		end

		-- DOC: 3.1.3.3 Will Topic
		local will_topic, will_payload
		will_topic, err = parse_string(read_func)
		if not will_topic then
			return false, "CONNECT: failed to parse will_topic: "..err
		end
		will.topic = will_topic

		-- DOC: 3.1.3.4 Will Payload
		will_payload, err = parse_string(read_func)
		if not will_payload then
			return false, "CONNECT: failed to parse will_payload: "..err
		end
		will.payload = will_payload
	end

	-- DOC: 3.1.3.5 User Name
	if packet.username then
		local username
		username, err = parse_string(read_func)
		if not username then
			return false, "CONNECT: failed to parse username: "..err
		end
		packet.username = username
	else
		packet.username = nil
	end

	-- DOC: 3.1.3.6 Password
	if packet.password then
		local password
		password, err = parse_string(read_func)
		if not password then
			return false, "CONNECT: failed to parse password: "..err
		end
		packet.password = password
	else
		packet.password = nil
	end

	return setmetatable(packet, packet_mt)
end

-- export module table
return protocol5

-- vim: ts=4 sts=4 sw=4 noet ft=lua

end
Loaders["qsys_mqtt.tls"] = function()
-- Explicit TLS credentials. Native CA trust outlives individual sockets.
-- Keep the first CA for this module lifetime; never clear it on client disposal.
local Tls = {}
local Limit = 131072
local InitialCa
local RestartRequired = false
local Fields = { "CaCertificate", "ClientCertificate", "ClientKey" }

local function FilePath(path)
  if
    type(path) ~= "string"
    or #path == 0
    or #path > 512
    or path:find("[%c\\:]")
    or path:find("//", 1, true)
    or not (path:sub(1, 6) == "media/" or path:sub(1, 7) == "design/")
  then
    return false
  end
  for segment in path:gmatch("[^/]+") do
    if segment == "." or segment == ".." then
      return false
    end
  end
  return path:sub(-1) ~= "/"
end

function Tls.Validate(options)
  for _, name in ipairs(Fields) do
    local data, path = options[name], options[name .. "File"]
    if data == "" then
      data = nil
      options[name] = nil
    end
    if path ~= nil and not FilePath(path) then
      return nil, "invalid-certificate-path"
    end
    if data ~= nil and (type(data) ~= "string" or #data > Limit) then
      return nil, "invalid-certificate-data"
    end
    if data and path then
      return nil, "certificate-source-conflict"
    end
  end
  local cert = options.ClientCertificate or options.ClientCertificateFile
  local key = options.ClientKey or options.ClientKeyFile
  if (cert and not key) or (key and not cert) then
    return nil, "client-certificate-key-required"
  end
  if cert and not options.Tls then
    return nil, "client-certificate-requires-tls"
  end
  if options.Tls and not (options.CaCertificate or options.CaCertificateFile) then
    return nil, "ca-certificate-required"
  end
  return true
end

local function ReadFile(path)
  local opened, file = pcall(function()
    return io.open(path, "rb")
  end)
  if not opened or not file then
    return nil, "file-open-failed"
  end
  local read, data = pcall(function()
    return file:read(Limit + 1)
  end)
  local closed, closeResult = pcall(function()
    return file:close()
  end)
  if not read or not closed or not closeResult then
    return nil, "file-read-failed"
  end
  if type(data) ~= "string" or #data == 0 then
    return nil, "file-empty"
  end
  if #data > Limit then
    return nil, "file-too-large"
  end
  return data
end

local function Pem(data, key)
  if data:find("%z") then
    return false
  end
  local labels = key and { "PRIVATE KEY", "RSA PRIVATE KEY", "EC PRIVATE KEY" } or { "CERTIFICATE" }
  if key and (data:find("ENCRYPTED", 1, true) or data:find("Proc-Type:", 1, true)) then
    return false
  end
  for _, label in ipairs(labels) do
    local start = data:find("-----BEGIN " .. label .. "-----", 1, true)
    local finish = data:find("-----END " .. label .. "-----", 1, true)
    if start and finish and finish > start then
      return true
    end
  end
  return false
end

function Tls.Load(options)
  if RestartRequired then
    return nil, "ca-change-requires-runtime-restart"
  end
  local result = {}
  for index, name in ipairs(Fields) do
    local data = options[name]
    local reason
    if options[name .. "File"] then
      data, reason = ReadFile(options[name .. "File"])
    end
    local label = ({ "ca", "client-cert", "client-key" })[index]
    if reason then
      return nil, label .. "-" .. reason
    end
    if data and not Pem(data, name == "ClientKey") then
      return nil, label .. "-invalid-pem"
    end
    result[name] = data
  end
  -- Pin before any native credential setter can modify process-wide trust.
  -- This is a local rotation guard, not isolation from other Lua environments.
  if InitialCa and result.CaCertificate ~= InitialCa then
    RestartRequired = true
    return nil, "ca-change-requires-runtime-restart"
  end
  InitialCa = result.CaCertificate
  return result
end

return Tls

end
Loaders["qsys_mqtt.v5"] = function()
local require = Require
-- Additional validation around the unmodified luamqtt 5.0 codec.
-- Bounds and single-occurrence rules are checked before decoding properties.
local Protocol = require("mqtt.protocol5")
local Packet = require("mqtt.protocol").packet_type
local Mqtt5 = {}

local Widths = {
  [0x01] = 1,
  [0x02] = 4,
  [0x03] = "text",
  [0x08] = "text",
  [0x09] = "binary",
  [0x0B] = "variable",
  [0x11] = 4,
  [0x12] = "text",
  [0x13] = 2,
  [0x15] = "text",
  [0x16] = "binary",
  [0x17] = 1,
  [0x18] = 4,
  [0x19] = 1,
  [0x1A] = "text",
  [0x1C] = "text",
  [0x1F] = "text",
  [0x21] = 2,
  [0x22] = 2,
  [0x23] = 2,
  [0x24] = 1,
  [0x25] = 1,
  [0x26] = "pair",
  [0x27] = 4,
  [0x28] = 1,
  [0x29] = 1,
  [0x2A] = 1,
}

function Mqtt5.ValidateFrame(frame, bodyStart, utf8)
  local kind = math.floor(frame:byte(1) / 16)
  local position = bodyStart
  local boundary = #frame + 1
  local function Take(count)
    assert(position + count <= boundary, "property-boundary")
    local data = frame:sub(position, position + count - 1)
    position = position + count
    return data
  end
  local function Variable()
    local value, multiplier = 0, 1
    for index = 1, 4 do
      local byte = Take(1):byte()
      value = value + (byte % 128) * multiplier
      if byte < 128 then
        assert(index == 1 or byte ~= 0, "noncanonical-property-length")
        return value
      end
      multiplier = multiplier * 128
    end
    error("property-length")
  end
  local function String(isText)
    local length = Take(2)
    local value = Take(length:byte(1) * 256 + length:byte(2))
    assert(not isText or utf8(value, true), "property-utf8")
  end
  if kind == Packet.PINGRESP then
    assert(position == boundary, "pingresp-length")
    return
  elseif kind == Packet.CONNACK then
    Take(2)
  elseif kind == Packet.PUBLISH then
    String(true)
    local qos = math.floor(frame:byte(1) / 2) % 4
    if qos > 0 then
      Take(2)
    end
  elseif kind == Packet.SUBACK or kind == Packet.UNSUBACK then
    Take(2)
  elseif kind == Packet.PUBACK then
    Take(2)
    if position == boundary then
      return
    end
    Take(1)
    if position == boundary then
      return
    end
  elseif kind == Packet.DISCONNECT then
    if position == boundary then
      return
    end
    Take(1)
    if position == boundary then
      return
    end
  else
    error("unsupported-server-packet")
  end
  local length = Variable()
  local propertiesEnd = position + length
  assert(propertiesEnd <= boundary, "property-length")
  boundary = propertiesEnd
  local seen = {}
  while position < propertiesEnd do
    local id = Variable()
    local width = assert(Widths[id], "unknown-property")
    assert(
      not seen[id] or id == 0x26 or (id == 0x0B and kind == Packet.PUBLISH),
      "duplicate-property"
    )
    seen[id] = true
    if width == "pair" then
      String(true)
      String(true)
    elseif width == "text" or width == "binary" then
      String(width == "text")
    elseif width == "variable" then
      assert(Variable() > 0, "zero-subscription-id")
    else
      Take(width)
    end
  end
  assert(position == propertiesEnd, "property-boundary")
  if kind == Packet.CONNACK or kind == Packet.PUBACK or kind == Packet.DISCONNECT then
    assert(position == #frame + 1, "unexpected-payload")
  elseif kind == Packet.SUBACK or kind == Packet.UNSUBACK then
    -- Each request in this client carries exactly one topic/filter.
    assert(position == #frame, "ack-reason-count")
  end
end

local ConnackCodes = {
  [0] = true,
  [128] = true,
  [129] = true,
  [130] = true,
  [131] = true,
  [132] = true,
  [133] = true,
  [134] = true,
  [135] = true,
  [136] = true,
  [137] = true,
  [138] = true,
  [140] = true,
  [144] = true,
  [149] = true,
  [151] = true,
  [153] = true,
  [154] = true,
  [155] = true,
  [156] = true,
  [157] = true,
  [159] = true,
}
local PubackCodes = {
  [0] = true,
  [16] = true,
  [128] = true,
  [131] = true,
  [135] = true,
  [144] = true,
  [145] = true,
  [151] = true,
  [153] = true,
}

function Mqtt5.ValidatePacket(packet, topic)
  local kind = packet.type
  local props = packet.properties or {}
  if kind == Packet.CONNACK then
    assert(ConnackCodes[packet.rc], "connack-code")
    assert(props.receive_maximum ~= 0, "receive-maximum-zero")
    assert(props.maximum_packet_size ~= 0, "maximum-packet-zero")
    assert(
      not props.authentication_method and not props.authentication_data,
      "unsolicited-authentication"
    )
    assert(not props.assigned_client_identifier, "unsolicited-assigned-id")
    assert(not props.response_information, "unsolicited-response-information")
  elseif kind == Packet.PUBLISH then
    -- CONNECT advertises no aliases and SUBSCRIBE does not assign identifiers.
    assert(
      not props.topic_alias and not props.subscription_identifiers,
      "unrequested-publish-feature"
    )
    assert(not props.response_topic or topic(props.response_topic, false), "response-topic")
  elseif kind == Packet.PUBACK then
    assert(PubackCodes[packet.rc], "puback-code")
  elseif kind == Packet.SUBACK then
    assert(#packet.rc == 1 and Protocol.suback_rc[packet.rc[1]], "suback-code")
  elseif kind == Packet.UNSUBACK then
    assert(#packet.rc == 1 and Protocol.unsuback_rc[packet.rc[1]], "unsuback-code")
  elseif kind == Packet.DISCONNECT then
    assert(Protocol.disconnect_rc[packet.rc] and packet.rc ~= 4, "disconnect-code")
    assert(not props.session_expiry_interval, "server-session-expiry")
  end
end

return Mqtt5

end
Loaders["qsys_mqtt"] = function()
local require = Require
-- Q-SYS MQTT 3.1.1 / 5.0 client. Private module state is intentional.
-- Keep the returned client in a script-global variable/table to retain host objects.
local Protocol4 = require("mqtt.protocol4")
local Protocol5 = require("mqtt.protocol5")
local Mqtt5 = require("qsys_mqtt.v5")
local Tls = require("qsys_mqtt.tls")
local Packet = require("mqtt.protocol").packet_type
local Mqtt = { Version = "0.3.1" }
local Client = {}
Client.__index = Client

--*** Input validation ***
local function Integer(value, minimum, maximum)
  return type(value) == "number"
    and value == math.floor(value)
    and value >= minimum
    and value <= maximum
end

local function Utf8(value, allowEmpty)
  if type(value) ~= "string" or #value > 65535 or (not allowEmpty and #value == 0) then
    return false
  end
  local index = 1
  while index <= #value do
    local first = value:byte(index)
    local count, code, minimum = 1, first, 0
    if first >= 0xC2 and first <= 0xDF then
      count, code, minimum = 2, first - 0xC0, 0x80
    elseif first >= 0xE0 and first <= 0xEF then
      count, code, minimum = 3, first - 0xE0, 0x800
    elseif first >= 0xF0 and first <= 0xF4 then
      count, code, minimum = 4, first - 0xF0, 0x10000
    elseif first == 0 or first >= 0x80 then
      return false
    end
    for offset = 1, count - 1 do
      local byte = value:byte(index + offset)
      if not byte or byte < 0x80 or byte > 0xBF then
        return false
      end
      code = code * 64 + byte - 0x80
    end
    if code < minimum or code > 0x10FFFF or (code >= 0xD800 and code <= 0xDFFF) then
      return false
    end
    index = index + count
  end
  return true
end

local function Topic(value, filter)
  if not Utf8(value, false) then
    return false
  end
  if not filter then
    return not value:find("[+#]")
  end
  for level in (value .. "/"):gmatch("(.-)/") do
    if
      (level:find("+", 1, true) and level ~= "+")
      or (level:find("#", 1, true) and level ~= "#")
    then
      return false
    end
  end
  local hash = value:find("#", 1, true)
  return not hash or hash == #value
end

function Mqtt.TopicMatches(filter, topic)
  if not Topic(filter, true) or not Topic(topic, false) then
    return false
  end
  if topic:sub(1, 1) == "$" and filter:sub(1, 1) ~= "$" then
    return false
  end
  local levels = {}
  for level in (topic .. "/"):gmatch("(.-)/") do
    levels[#levels + 1] = level
  end
  local index = 1
  for level in (filter .. "/"):gmatch("(.-)/") do
    if level == "#" then
      return true
    end
    if levels[index] == nil or (level ~= "+" and level ~= levels[index]) then
      return false
    end
    index = index + 1
  end
  return index == #levels + 1
end

local function Call(self, callback, ...)
  if callback then
    local ok = pcall(callback, self, ...)
    if not ok and callback ~= self.OnError and self.OnError then
      pcall(self.OnError, self, "callback-error")
    end
  end
end

function Client:_State(state, reason)
  self.State = state
  Call(self, self.OnState, state, reason)
end

function Client:_Trace(direction, kind, size)
  -- Never expose payloads, credentials, certificates or raw CONNECT bytes.
  Call(self, self.OnTrace, direction, Packet[kind] or "UNKNOWN", size)
end

--*** Transport lifetime and recovery ***
-- Q-SYS callback setters require functions, including when retiring a host object.
local function IgnoreEvent() end
function Client:_Release()
  self.Epoch = self.Epoch + 1
  if self.Socket then
    local socket = self.Socket
    self.Socket = nil
    socket.Connected = IgnoreEvent
    socket.Data = IgnoreEvent
    socket.Closed = IgnoreEvent
    socket.Error = IgnoreEvent
    socket.Timeout = IgnoreEvent
    socket.Reconnect = IgnoreEvent
    pcall(function()
      socket:Disconnect()
    end)
  end
  self.WorkTimer:Stop()
  self.Buffer = ""
  self.FrameSince = nil
  self.PingAt = nil
  self.Pumping = false
end

function Client:_FailPending(reason)
  local pending = self.Pending
  self.Pending = {}
  self.PendingCount = 0
  for _, operation in pairs(pending) do
    Call(self, operation.Callback, false, reason)
  end
end

function Client:_Lost(reason)
  if self.Closing or self.State == "Disconnected" or self.State == "Reconnecting" then
    return
  end
  self.Closing = true
  self:_Release()
  self.RetryAt = self.Now() + self.RetryDelay
  self.RetryDelay = math.min(self.RetryDelay * 2, 30)
  self.State = self.Wanted and "Reconnecting" or "Disconnected"
  self:_FailPending("unconfirmed: " .. reason)
  if not self.Wanted then
    self.State = "Disconnected"
  end
  self.Closing = false
  self:_State(self.State, reason)
end

function Client:_Send(args)
  local epoch = self.Epoch
  if not self.Socket or not self.Socket.IsConnected then
    return nil, "not-connected"
  end
  if self.IsV5 and (args.type == Packet.PUBACK or args.type == Packet.DISCONNECT) then
    args.rc = args.rc or 0
  end
  local ok, data = pcall(function()
    return tostring(self.Protocol.make_packet(args))
  end)
  if not ok then
    return nil, "invalid-packet"
  end
  if #data > math.min(self.Options.MaxPacketBytes, self.ServerPacketLimit) then
    return nil, "packet-too-large"
  end
  ok = pcall(function()
    self.Socket:Write(data)
  end)
  if not ok then
    self:_Lost("write-failed")
    return nil, "write-failed"
  end
  self.LastWrite = self.Now()
  self:_Trace("Tx", args.type, #data)
  if epoch ~= self.Epoch or self.Disposed then
    return nil, "connection-changed"
  end
  return true
end

function Client:_Open()
  self:_Release()
  self.ServerPacketLimit = self.Options.MaxPacketBytes
  self.ServerReceiveMaximum = 65535
  self.ServerMaximumQos = 2
  self.ServerRetainAvailable = true
  self.ServerWildcardAvailable = true
  self.EffectiveKeepAlive = self.Options.KeepAlive
  self.ServerProperties = {}
  self.State = "Connecting"
  self.Deadline = self.Now() + self.Options.Timeout
  local epoch = self.Epoch
  local credentials
  if self.Options.Tls then
    local reason
    credentials, reason = Tls.Load(self.Options)
    if not credentials then
      if reason == "ca-change-requires-runtime-restart" then
        self.Wanted = false
        self.TickTimer:Stop()
        self:_FailPending("unconfirmed: " .. reason)
        self:_State("Disconnected", reason)
      else
        self:_Lost(reason)
      end
      return
    end
  end
  local ok = pcall(function()
    self.Socket = self.NewSocket(self.Options.Tls)
    self.Socket.ReconnectTimeout = 0
    self.Socket.ReadTimeout = 0
    self.Socket.WriteTimeout = 0
    if self.Options.Tls then
      -- Follow the official example order. Credential setters can affect native TLS
      -- state; enable validation last (Designer 10.5 wrong-CA regression).
      if credentials.ClientCertificate then
        self.Socket.ClientCertData = credentials.ClientCertificate
        self.Socket.ClientKeyData = credentials.ClientKey
      end
      self.Socket.CACertData = credentials.CaCertificate
      self.Socket.ValidateCertificate = true
    end
    self.Socket.Connected = function()
      if epoch ~= self.Epoch or self.State ~= "Connecting" then
        return
      end
      self.State = "AwaitingConnack"
      self.Deadline = self.Now() + self.Options.Timeout
      local sent, reason = self:_Send({
        type = Packet.CONNECT,
        id = self.Options.ClientId,
        clean = true,
        keep_alive = self.Options.KeepAlive,
        username = self.Options.Username,
        password = self.Options.Password,
        will = self.Options.Will,
        properties = self.IsV5 and {
          session_expiry_interval = 0,
          maximum_packet_size = self.Options.MaxPacketBytes,
          topic_alias_maximum = 0,
        } or nil,
      })
      if epoch ~= self.Epoch then
        return
      end
      if not sent then
        self:_Lost(reason)
      end
    end
    self.Socket.Data = function()
      if epoch == self.Epoch then
        self:_Pump()
      end
    end
    self.Socket.Closed = function()
      if epoch == self.Epoch then
        self:_Lost("socket-closed")
      end
    end
    self.Socket.Error = function()
      if epoch == self.Epoch then
        self:_Lost("socket-error")
      end
    end
    self.Socket.Timeout = function()
      if epoch == self.Epoch then
        self:_Lost("socket-timeout")
      end
    end
    self.Socket:Connect(self.Options.Host, self.Options.Port)
  end)
  if epoch ~= self.Epoch then
    return
  end
  if not ok then
    self:_Lost("transport-setup-failed")
  elseif self.State == "Connecting" then
    self:_State("Connecting", "opening-transport")
  end
end

function Client:Connect()
  if self.Disposed or self.Closing then
    return nil, "client-unavailable"
  end
  if self.State ~= "Disconnected" then
    return nil, "already-started"
  end
  self.Wanted = true
  self.TickTimer:Start(0.25)
  self:_Open()
  return true
end

function Client:Disconnect()
  self.Wanted = false
  self.TickTimer:Stop()
  if self.Closing then
    return
  end
  self.Closing = true
  if self.State == "Connected" then
    self:_Send({ type = Packet.DISCONNECT })
  end
  self:_Release()
  self.State = "Disconnected"
  self:_FailPending("unconfirmed: disconnected")
  self.Closing = false
  self:_State("Disconnected", "requested")
end

function Client:Dispose()
  self.Disposed = true
  self.Wanted = false
  self:Disconnect()
  self.TickTimer:Stop()
  self.TickTimer.EventHandler = IgnoreEvent
  self.WorkTimer:Stop()
  self.WorkTimer.EventHandler = IgnoreEvent
end

--*** Bounded operations and subscription intent ***
function Client:_Request(args, callback, filter, qos)
  if self.State ~= "Connected" or self.Closing then
    return nil, "not-connected"
  end
  if callback ~= nil and type(callback) ~= "function" then
    return nil, "invalid-callback"
  end
  if args.type == Packet.PUBLISH and self.IsV5 then
    local publishes = 0
    for _, operation in pairs(self.Pending) do
      if operation.Kind == Packet.PUBLISH then
        publishes = publishes + 1
      end
    end
    if publishes >= self.ServerReceiveMaximum then
      return nil, "broker-receive-limit"
    end
  end
  if
    args.type == Packet.SUBSCRIBE
    and self.IsV5
    and not self.ServerWildcardAvailable
    and filter:find("[+#]")
  then
    return nil, "broker-wildcards-unavailable"
  end
  if self.PendingCount >= self.Options.MaxInflight then
    return nil, "inflight-limit"
  end
  repeat
    self.NextId = self.NextId % 65535 + 1
  until not self.Pending[self.NextId]
  args.packet_id = self.NextId
  local operation = {
    Kind = args.type,
    Callback = callback,
    Filter = filter,
    Qos = qos,
    Deadline = self.Now() + self.Options.Timeout,
  }
  self.Pending[args.packet_id] = operation
  self.PendingCount = self.PendingCount + 1
  local sent, reason = self:_Send(args)
  if not sent then
    if self.Pending[args.packet_id] == operation then
      self.Pending[args.packet_id] = nil
      self.PendingCount = self.PendingCount - 1
    end
    return nil, reason
  end
  return true, args.packet_id
end

function Client:Publish(topic, payload, qos, retain, callback)
  qos = qos or 0
  if
    not Topic(topic, false)
    or type(payload) ~= "string"
    or not Integer(qos, 0, 1)
    or (retain ~= nil and type(retain) ~= "boolean")
    or (callback ~= nil and type(callback) ~= "function")
  then
    return nil, "invalid-publish"
  end
  if self.State ~= "Connected" or self.Closing then
    return nil, "not-connected"
  end
  if self.IsV5 and qos > self.ServerMaximumQos then
    return nil, "broker-qos-unavailable"
  end
  if self.IsV5 and retain and not self.ServerRetainAvailable then
    return nil, "broker-retain-unavailable"
  end
  if #payload + #topic + 9 > self.Options.MaxPacketBytes then
    return nil, "packet-too-large"
  end
  local args =
    { type = Packet.PUBLISH, topic = topic, payload = payload, qos = qos, retain = retain or false }
  if qos == 1 then
    return self:_Request(args, callback)
  end
  local ok, reason = self:_Send(args)
  if ok then
    Call(self, callback, true, "written-unacknowledged")
  end
  return ok, reason
end

function Client:Subscribe(filter, qos, callback)
  qos = qos or 0
  if not Topic(filter, true) or not Integer(qos, 0, 1) then
    return nil, "invalid-subscription"
  end
  if self.IsV5 and filter:sub(1, 7) == "$share/" then
    return nil, "shared-subscriptions-unsupported"
  end
  for _, operation in pairs(self.Pending) do
    if operation.Filter == filter then
      return nil, "subscription-pending"
    end
  end
  local count = 0
  for _ in pairs(self.Subscriptions) do
    count = count + 1
  end
  if not self.Subscriptions[filter] and count >= 32 then
    return nil, "subscription-limit"
  end
  local ok, result = self:_Request({
    type = Packet.SUBSCRIBE,
    subscriptions = { { topic = filter, qos = qos } },
  }, callback, filter, qos)
  if ok then
    self.Subscriptions[filter] = qos
  end
  return ok, result
end

function Client:Unsubscribe(filter, callback)
  if not Topic(filter, true) then
    return nil, "invalid-subscription"
  end
  if self.IsV5 and filter:sub(1, 7) == "$share/" then
    return nil, "shared-subscriptions-unsupported"
  end
  for _, operation in pairs(self.Pending) do
    if operation.Filter == filter then
      return nil, "subscription-pending"
    end
  end
  local ok, result = self:_Request({
    type = Packet.UNSUBSCRIBE,
    subscriptions = { filter },
  }, callback, filter)
  if ok then
    self.Subscriptions[filter] = nil
  end
  return ok, result
end

function Client:_Ack(packet)
  local operation = self.Pending[packet.packet_id]
  local expected = {
    [Packet.PUBACK] = Packet.PUBLISH,
    [Packet.SUBACK] = Packet.SUBSCRIBE,
    [Packet.UNSUBACK] = Packet.UNSUBSCRIBE,
  }
  if not operation then
    return
  end -- Duplicate/late acknowledgements carry no new result.
  if operation.Kind ~= expected[packet.type] then
    error("ack-kind")
  end
  local success, detail = true, "broker-acknowledged"
  if packet.type == Packet.SUBACK then
    if #packet.rc ~= 1 or (packet.rc[1] < 128 and packet.rc[1] > operation.Qos) then
      error("invalid-suback")
    end
    success = packet.rc[1] < 128
    detail = success and packet.rc[1]
      or (self.IsV5 and ("subscription-refused-" .. packet.rc[1]) or "subscription-refused")
    if not success then
      self.Subscriptions[operation.Filter] = nil
    end
  end
  if self.IsV5 and packet.type ~= Packet.SUBACK then
    local code = packet.type == Packet.UNSUBACK and packet.rc[1] or packet.rc
    success = code < 128
    if not success then
      detail = "broker-rejected-" .. code
    elseif code == 16 then
      detail = "broker-acknowledged-no-subscribers"
    elseif code == 17 then
      detail = "no-subscription-existed"
    end
  end
  self.Pending[packet.packet_id] = nil
  self.PendingCount = self.PendingCount - 1
  local epoch = self.Epoch
  Call(self, operation.Callback, success, detail)
  if epoch == self.Epoch and packet.type == Packet.SUBACK then
    Call(self, self.OnSubscription, operation.Filter, success, detail)
  end
end

--*** Framing and protocol validation ***
function Client:_Packet(frame)
  local position = 1
  local bodyStart = 2
  repeat
    bodyStart = bodyStart + 1
  until frame:byte(bodyStart - 1) < 128
  if self.IsV5 then
    Mqtt5.ValidateFrame(frame, bodyStart, Utf8)
  end
  local packet, reason = self.Protocol.parse_packet(function(count)
    if position + count - 1 > #frame then
      return nil, "short-frame"
    end
    local data = frame:sub(position, position + count - 1)
    position = position + count
    return data
  end)
  if not packet then
    error(reason)
  end
  local kind = packet.type
  if kind ~= Packet.PUBLISH and frame:byte(1) % 16 ~= 0 then
    error("reserved-flags")
  end
  if kind == Packet.CONNACK and frame:byte(bodyStart) ~= 0 then
    error("connack-flags")
  end
  if
    kind ~= Packet.CONNACK
    and kind ~= Packet.PUBLISH
    and kind ~= Packet.PUBACK
    and kind ~= Packet.SUBACK
    and kind ~= Packet.UNSUBACK
    and kind ~= Packet.PINGRESP
    and not (self.IsV5 and kind == Packet.DISCONNECT)
  then
    error("unexpected-packet")
  end
  if packet.packet_id and not Integer(packet.packet_id, 1, 65535) then
    error("packet-id")
  end
  if kind == Packet.PUBLISH then
    if
      not Integer(packet.qos, 0, 1)
      or (packet.qos == 0 and packet.dup)
      or not Topic(packet.topic, false)
    then
      error("publish-header")
    end
  end
  if self.IsV5 then
    Mqtt5.ValidatePacket(packet, Topic)
  elseif kind == Packet.SUBACK then
    if #packet.rc ~= 1 or (packet.rc[1] ~= 0 and packet.rc[1] ~= 1 and packet.rc[1] ~= 128) then
      error("suback-code")
    end
  end
  local epoch = self.Epoch
  self:_Trace("Rx", kind, #frame)
  if epoch ~= self.Epoch or self.Disposed then
    return
  end
  if self.State == "AwaitingConnack" then
    if kind ~= Packet.CONNACK or packet.sp or (not self.IsV5 and not Integer(packet.rc, 0, 5)) then
      error("connack")
    end
    if packet.rc ~= 0 then
      self:_Lost("broker-refused-" .. packet.rc)
      return
    end
    if self.IsV5 then
      local props = packet.properties
      self.ServerProperties = props
      self.ServerPacketLimit = props.maximum_packet_size or self.Options.MaxPacketBytes
      self.ServerReceiveMaximum = props.receive_maximum or 65535
      self.ServerMaximumQos = props.maximum_qos or 2
      self.ServerRetainAvailable = props.retain_available ~= 0
      self.ServerWildcardAvailable = props.wildcard_subscription_available ~= 0
      self.EffectiveKeepAlive = props.server_keep_alive or self.Options.KeepAlive
      if props.session_expiry_interval and props.session_expiry_interval > 0 then
        self:_Send({ type = Packet.DISCONNECT, properties = { session_expiry_interval = 0 } })
        if epoch == self.Epoch then
          self:_Lost("unsupported-session-expiry")
        end
        return
      end
    end
    self.State = "Connected"
    self.RetryDelay = 1
    local epoch = self.Epoch
    for filter, qos in pairs(self.Subscriptions) do
      local ok, reason = self:_Request(
        { type = Packet.SUBSCRIBE, subscriptions = { { topic = filter, qos = qos } } },
        nil,
        filter,
        qos
      )
      if epoch ~= self.Epoch then
        return
      end
      if not ok then
        if reason == "broker-wildcards-unavailable" or reason == "packet-too-large" then
          self.Subscriptions[filter] = nil
          Call(self, self.OnSubscription, filter, false, reason)
          if epoch ~= self.Epoch then
            return
          end
        else
          self:_Lost("resubscribe-failed")
          return
        end
      end
    end
    if epoch == self.Epoch then
      self:_State("Connected", "broker-accepted")
    end
  elseif self.State ~= "Connected" or kind == Packet.CONNACK then
    error("unexpected-state")
  elseif self.IsV5 and kind == Packet.DISCONNECT then
    self:_Lost("broker-disconnected-" .. packet.rc)
  elseif kind == Packet.PUBLISH then
    if packet.qos == 1 then
      local ok = self:_Send({ type = Packet.PUBACK, packet_id = packet.packet_id })
      if not ok then
        if epoch == self.Epoch then
          self:_Lost("acknowledgement-send-failed")
        end
        return
      end
    end
    Call(self, self.OnMessage, {
      Topic = packet.topic,
      Payload = packet.payload or "",
      Qos = packet.qos,
      Retain = packet.retain,
      Duplicate = packet.dup,
      Properties = packet.properties,
      UserProperties = packet.user_properties,
    })
  elseif kind == Packet.PINGRESP then
    self.PingAt = nil
  else
    self:_Ack(packet)
  end
end

function Client:_PumpBody(epoch)
  local available = self.Socket.BufferLength
  if #self.Buffer + available > self.Options.MaxPacketBytes * 2 then
    error("receive-limit")
  end
  if available > 0 then
    local data = self.Socket:Read(math.min(available, 8192))
    if data and #data > 0 then
      self.Buffer = self.Buffer .. data
      self.FrameSince = self.FrameSince or self.Now()
    end
  end
  local processed = 0
  while #self.Buffer >= 2 and processed < 16 do
    local length, multiplier, index = 0, 1, 2
    while true do
      local byte = self.Buffer:byte(index)
      if not byte then
        return
      end
      length = length + (byte % 128) * multiplier
      if length + index > self.Options.MaxPacketBytes then
        error("packet-too-large")
      end
      if byte < 128 then
        if index > 2 and byte == 0 then
          error("noncanonical-length")
        end
        break
      end
      if index == 5 then
        error("malformed-length")
      end
      multiplier = multiplier * 128
      index = index + 1
    end
    if #self.Buffer < length + index then
      break
    end
    local frame = self.Buffer:sub(1, length + index)
    self.Buffer = self.Buffer:sub(length + index + 1)
    self.FrameSince = #self.Buffer > 0 and self.Now() or nil
    self:_Packet(frame)
    if epoch ~= self.Epoch then
      return
    end
    processed = processed + 1
  end
  if self.Socket.BufferLength > 0 or (processed == 16 and #self.Buffer > 0) then
    self.WorkTimer:Start(0.01)
  end
end

function Client:_Pump()
  if self.Pumping or not self.Socket then
    return
  end
  self.Pumping = true
  local epoch = self.Epoch
  local ok, failure = pcall(function()
    self:_PumpBody(epoch)
  end)
  self.Pumping = false
  if not ok and epoch == self.Epoch then
    if self.IsV5 and self.State == "Connected" then
      local code = tostring(failure):find("packet-too-large", 1, true) and 149 or 130
      self:_Send({ type = Packet.DISCONNECT, rc = code })
    end
    if epoch == self.Epoch then
      self:_Lost("invalid-or-excessive-input")
    end
  end
  if ok and epoch == self.Epoch and self.Socket and self.Socket.BufferLength > 0 then
    self.WorkTimer:Start(0.01)
  end
end

function Client:_Tick()
  local now = self.Now()
  if self.State == "Reconnecting" and self.Wanted and now >= self.RetryAt then
    self:_Open()
  elseif
    (self.State == "Connecting" or self.State == "AwaitingConnack") and now >= self.Deadline
  then
    self:_Lost("connection-timeout")
  elseif self.State == "Connected" then
    if self.FrameSince and now - self.FrameSince >= self.Options.Timeout then
      self:_Lost("incomplete-packet-timeout")
      return
    end
    for _, operation in pairs(self.Pending) do
      if now >= operation.Deadline then
        self:_Lost("acknowledgement-timeout")
        return
      end
    end
    if self.PingAt and now - self.PingAt >= self.Options.Timeout then
      self:_Lost("ping-timeout")
    elseif
      self.EffectiveKeepAlive > 0
      and not self.PingAt
      and now - self.LastWrite >= self.EffectiveKeepAlive * 0.75
    then
      self.PingAt = now
      self:_Send({ type = Packet.PINGREQ })
    end
  end
end

--*** Public construction ***
function Mqtt.New(options, host)
  if type(options) ~= "table" then
    return nil, "options-required"
  end
  local config = {}
  for key, value in pairs(options) do
    config[key] = value
  end
  config.ProtocolVersion = config.ProtocolVersion or "3.1.1"
  if config.ProtocolVersion ~= "3.1.1" and config.ProtocolVersion ~= "5.0" then
    return nil, "unsupported-protocol-version"
  end
  config.Port = config.Port or (config.Tls and 8883 or 1883)
  config.KeepAlive = config.KeepAlive == nil and 30 or config.KeepAlive
  config.Timeout = config.Timeout or 10
  config.MaxPacketBytes = config.MaxPacketBytes or 65536
  config.MaxInflight = config.MaxInflight or 64
  if
    type(config.Host) ~= "string"
    or #config.Host == 0
    or #config.Host > 253
    or config.Host:find("[%z%s]")
    or not Integer(config.Port, 1, 65535)
    or not Utf8(config.ClientId, false)
    or not Integer(config.KeepAlive, 0, 65535)
    or not Integer(config.Timeout, 1, 120)
    or not Integer(config.MaxPacketBytes, 128, 1048576)
    or not Integer(config.MaxInflight, 32, 256)
    or (config.Tls ~= nil and type(config.Tls) ~= "boolean")
  then
    return nil, "invalid-options"
  end
  if config.Username ~= nil and not Utf8(config.Username, true) then
    return nil, "invalid-username"
  end
  if
    config.Password ~= nil
    and (type(config.Password) ~= "string" or #config.Password > 65535 or config.Username == nil)
  then
    return nil, "invalid-password"
  end
  local validTls, tlsReason = Tls.Validate(config)
  if not validTls then
    return nil, tlsReason
  end
  if config.Will ~= nil then
    local will = config.Will
    if
      type(will) ~= "table"
      or not Topic(will.Topic, false)
      or type(will.Payload) ~= "string"
      or #will.Payload > 65535
      or not Integer(will.Qos or 0, 0, 1)
      or (will.Retain ~= nil and type(will.Retain) ~= "boolean")
    then
      return nil, "invalid-will"
    end
    config.Will = {
      topic = will.Topic,
      payload = will.Payload,
      qos = will.Qos or 0,
      retain = will.Retain or false,
    }
  end
  host = host
    or {
      Now = function()
        return Timer.Now()
      end,
      NewTimer = function()
        return Timer.New()
      end,
      NewSocket = function(tls)
        if tls then
          return TcpSocket.NewTls()
        end
        return TcpSocket.New()
      end,
    }
  local self = setmetatable({
    Options = config,
    Protocol = config.ProtocolVersion == "5.0" and Protocol5 or Protocol4,
    IsV5 = config.ProtocolVersion == "5.0",
    ServerPacketLimit = config.MaxPacketBytes,
    Now = host.Now,
    NewSocket = host.NewSocket,
    State = "Disconnected",
    Wanted = false,
    Epoch = 0,
    Buffer = "",
    NextId = 0,
    Pending = {},
    PendingCount = 0,
    Subscriptions = {},
    RetryDelay = 1,
  }, Client)
  self.TickTimer = host.NewTimer()
  self.WorkTimer = host.NewTimer()
  self.TickTimer.EventHandler = function()
    self:_Tick()
  end
  self.WorkTimer.EventHandler = function()
    self.WorkTimer:Stop()
    self:_Pump()
  end
  return self
end

return Mqtt

end
return Require("qsys_mqtt")
end)()

  --*** Control aliases and persistent objects ***
  SavedPassword = SecretStorage["text.1"]
  MqttClient = nil
  ActiveFilters = {}
  StartupTimer = Timer.New()
  DebugTx = false
  DebugRx = false
  DebugFunctions = false

  --*** Functions ***
  function SetupDebug()
    local mode = Properties["Debug Print"].Value
    DebugTx = mode == "Tx" or mode == "Tx/Rx" or mode == "All"
    DebugRx = mode == "Rx" or mode == "Tx/Rx" or mode == "All"
    DebugFunctions = mode == "Function Calls" or mode == "All"
  end

  function SetStatus(value, text)
    Controls.Status.Value = value
    Controls.Status.String = text
  end

  function ClearReceived()
    for channel = 1, Properties.Channels.Value do
      Controls["Subscribed" .. channel].Boolean = false
      Controls["ReceivedValid" .. channel].Boolean = false
      Controls["ReceivedTopic" .. channel].String = ""
      Controls["ReceivedPayload" .. channel].String = ""
      Controls["ReceivedFormat" .. channel].String = ""
      Controls["SubscriptionResult" .. channel].String = "Not subscribed"
    end
  end

  function StopClient()
    StartupTimer:Stop()
    if MqttClient then
      MqttClient:Dispose()
    end
    MqttClient = nil
    Controls.Connected.Boolean = false
    ClearReceived()
  end

  function DisplayPayload(payload)
    local clipped = #payload > 2048
    payload = payload:sub(1, 2048)
    local format = "Text"
    if payload:find("[^ -~\r\n\t]") then
      format = "Hex"
      payload = payload:gsub(".", function(byte)
        return string.format("%02X", byte:byte())
      end)
    end
    if clipped then
      format = format .. " (truncated)"
    end
    return payload, format
  end

  function StartClient()
    if DebugFunctions then
      print("MQTT: StartClient")
    end
    StopClient()
    if not Controls.Enable.Boolean then
      SetStatus(3, "Disabled")
      return
    end
    local options = {
      ProtocolVersion = Properties["MQTT Version"] and Properties["MQTT Version"].Value or "3.1.1",
      Host = Controls.IPAddress.String,
      Port = Controls.Port.Value,
      ClientId = Controls.ClientId.String,
      Tls = Controls.Tls.Boolean,
      CaCertificate = Controls.CaCertificate.String,
      KeepAlive = Controls.KeepAlive.Value,
    }
    if Controls.CaFromFile.Boolean then
      options.CaCertificate = nil
      options.CaCertificateFile = Controls.CaCertificateFile.String
    end
    if Controls.MutualTls.Boolean then
      options.ClientCertificateFile = Controls.ClientCertificateFile.String
      options.ClientKeyFile = Controls.ClientKeyFile.String
    end
    if Controls.Username.String ~= "" then
      options.Username = Controls.Username.String
      options.Password = SavedPassword.String
    elseif SavedPassword.String ~= "" then
      SetStatus(2, "Password requires username")
      return
    end
    if Controls.WillTopic.String ~= "" then
      options.Will = {
        Topic = Controls.WillTopic.String,
        Payload = Controls.WillPayload.String,
        Qos = tonumber(Controls.WillQos.String),
        Retain = Controls.WillRetain.Boolean,
      }
      if options.Will.Qos == nil then
        SetStatus(2, "Invalid Will QoS")
        return
      end
    end
    local reason
    MqttClient, reason = Mqtt.New(options)
    if not MqttClient then
      SetStatus(2, reason)
      return
    end
    ActiveFilters = {}
    for channel = 1, Properties.Channels.Value do
      ActiveFilters[channel] = {
        Filter = Controls["SubscribeFilter" .. channel].String,
        Qos = tonumber(Controls["SubscribeQos" .. channel].String),
      }
      if ActiveFilters[channel].Qos ~= 0 and ActiveFilters[channel].Qos ~= 1 then
        StopClient()
        SetStatus(2, "Invalid subscription QoS")
        return
      end
    end
    MqttClient.OnTrace = function(_, direction, packetType, bytes)
      if (direction == "Tx" and DebugTx) or (direction == "Rx" and DebugRx) then
        print("MQTT " .. direction .. " " .. packetType .. " (" .. bytes .. " bytes)")
      end
    end
    MqttClient.OnError = function(_, errorCode)
      print("MQTT: " .. errorCode)
      SetStatus(2, errorCode)
    end
    MqttClient.OnSubscription = function(_, filter, ok, detail)
      for channel, active in ipairs(ActiveFilters) do
        if active.Filter == filter then
          Controls["Subscribed" .. channel].Boolean = ok
          Controls["SubscriptionResult" .. channel].String = ok
              and "Subscribed (QoS " .. detail .. ")"
            or detail
        end
      end
    end
    MqttClient.OnState = function(client, state, detail)
      print("MQTT: " .. state .. " (" .. detail .. ")")
      Controls.Connected.Boolean = state == "Connected"
      local statusValue = 2
      if state == "Connected" then
        statusValue = 0
      elseif state == "Connecting" then
        statusValue = 5
      elseif state == "Disconnected" and detail == "requested" then
        -- Deliberately inactive, rather than a failed enabled connection.
        statusValue = 3
      end
      local statusText = state .. ": " .. detail
      if detail == "ca-change-requires-runtime-restart" then
        statusText = "CA changed: Save to Core & Run required"
      end
      SetStatus(statusValue, statusText)
      if state ~= "Connected" then
        ClearReceived()
      elseif not client.PluginConfigured then
        client.PluginConfigured = true
        local filters = {}
        for _, active in ipairs(ActiveFilters) do
          if active.Filter ~= "" then
            filters[active.Filter] = math.max(filters[active.Filter] or 0, active.Qos)
          end
        end
        for filter, qos in pairs(filters) do
          local ok, errorCode = client:Subscribe(filter, qos)
          if not ok then
            client.OnSubscription(client, filter, false, errorCode)
          end
        end
      end
    end
    MqttClient.OnMessage = function(_, message)
      for channel, active in ipairs(ActiveFilters) do
        if Mqtt.TopicMatches(active.Filter, message.Topic) then
          local payload, format = DisplayPayload(message.Payload)
          Controls["ReceivedTopic" .. channel].String = message.Topic
          Controls["ReceivedPayload" .. channel].String = payload
          Controls["ReceivedFormat" .. channel].String = format
          Controls["ReceivedValid" .. channel].Boolean = true
          Controls["MessageCount" .. channel].Value = (
            Controls["MessageCount" .. channel].Value + 1
          ) % 1000000000
          Controls["MessageReceived" .. channel]:Trigger()
        end
      end
    end
    MqttClient:Connect()
  end

  function PublishChannel(channel)
    if DebugFunctions then
      print("MQTT: PublishChannel " .. channel)
    end
    local result = Controls["PublishResult" .. channel]
    local payload = Controls["PublishPayload" .. channel].String
    local qos = tonumber(Controls["PublishQos" .. channel].String)
    if not MqttClient then
      result.String = "Not connected"
      return
    end
    if #payload > 2048 then
      result.String = "Payload limit: 2048 bytes"
      return
    end
    if qos == nil then
      result.String = "Invalid QoS"
      return
    end
    result.String = "Awaiting result"
    local ok, reason = MqttClient:Publish(
      Controls["PublishTopic" .. channel].String,
      payload,
      qos,
      Controls["PublishRetain" .. channel].Boolean,
      function(_, success, detail)
        result.String = success
            and detail == "broker-acknowledged-no-subscribers"
            and "ACK: no subscribers"
          or ((success and "OK: " or "Failed: ") .. detail)
      end
    )
    if not ok then
      result.String = reason
    end
  end

  --*** Event handlers ***
  Controls.Password.EventHandler = function(control)
    SavedPassword.String = control.String
    control.String = control.String ~= "" and "********" or ""
  end
  Controls.Enable.EventHandler = StartClient
  Controls.Reconnect.EventHandler = StartClient
  for channel = 1, Properties.Channels.Value do
    Controls["Publish" .. channel].EventHandler = function()
      PublishChannel(channel)
    end
  end
  StartupTimer.EventHandler = function()
    StartupTimer:Stop()
    StartClient()
  end

  --*** Initialization ***
  SetupDebug()
  print("MQTT Client " .. PluginInfo.Version)
  Controls.Password.String = SavedPassword.String ~= "" and "********" or ""
  Controls.WillQos.Choices = { "0", "1" }
  for channel = 1, Properties.Channels.Value do
    Controls["PublishQos" .. channel].Choices = { "0", "1" }
    Controls["SubscribeQos" .. channel].Choices = { "0", "1" }
    Controls["PublishResult" .. channel].String = "No publish requested"
    Controls["MessageCount" .. channel].Value = 0
  end
  ClearReceived()
  Controls.Connected.Boolean = false
  SetStatus(3, "Disabled")
  if Controls.Enable.Boolean then
    StartupTimer:Start(1)
  end
end
