    Size = { 390, 285 },
    Fill = PanelGray,
    StrokeWidth = 0,
  })
  table.insert(graphics, {
    Type = "Header",
    Text = "Publish",
    Position = { 35, 140 },
    Size = { 330, 16 },
    Color = Black,
    FontSize = 14,
  })
  table.insert(graphics, {
    Type = "Header",
    Text = "Subscribe",
    Position = { 35, 335 },
    Size = { 330, 16 },
    Color = Black,
    FontSize = 14,
  })
  local rows = {
    { "PublishTopic", "Topic", "Text", 165 },
    { "PublishPayload", "Payload", "Text", 190 },
    { "PublishQos", "QoS", "ComboBox", 215 },
    { "PublishRetain", "Retain", "Button", 240 },
    { "Publish", "Publish message", "Button", 265 },
    { "PublishResult", "Publish result", "Text", 290, true },
    { "SubscribeFilter", "Topic filter", "Text", 360 },
    { "SubscribeQos", "Requested QoS", "ComboBox", 385 },
    { "Subscribed", "Subscribed", "Led", 410 },
    { "SubscriptionResult", "Subscription result", "Text", 435, true },
    { "ReceivedTopic", "Received topic", "Text", 460, true },
    { "ReceivedPayload", "Received payload", "Text", 485, true },
    { "ReceivedFormat", "Payload format", "Text", 510, true },
    { "ReceivedValid", "Received value valid", "Led", 535 },
    { "MessageCount", "Message count", "Text", 560, true },
    { "MessageReceived", "Message event", "Button", 585, true },
  }
  for _, row in ipairs(rows) do
    local base, label, style, y, readOnly = table.unpack(row)
    local name = base .. channel
    table.insert(graphics, {
      Type = "Label",
      Text = label,
      Position = { 15, y },
      Size = { 155, 20 },
      Color = Black,
      HTextAlign = "Right",
      FontSize = 13,
    })
    layout[name] = {
      Style = style,
      Position = { 180, y },
      Size = { 200, 20 },
      PrettyName = "Channel " .. channel .. "~" .. label,
      FontSize = 13,
    }
    if readOnly then
      layout[name].IsReadOnly = true
    end
    if style == "Button" then
      layout[name].ButtonStyle = base == "PublishRetain" and "Toggle" or "Trigger"
      layout[name].Size = { 45, 20 }
      layout[name].Color = White
      layout[name].CornerRadius = 2
      layout[name].Margin = 2
    elseif style == "Led" then
      layout[name].Color = IndicatorGreen
      layout[name].Size = { 20, 20 }
    elseif readOnly then
      layout[name].Color = ReadoutGray
    end
  end
end

function GetControlLayout(props)
  local page = props.page_index.Value
  local certificatePage = page == props.Channels.Value + 2
  local height = page == 1 and 755 or (certificatePage and 475 or 640)
  local layout = {}
  local graphics = {
    {
      Type = "GroupBox",
      Position = { 0, 0 },
      Size = { 400, height },
      Fill = White,
      StrokeWidth = 0,
    },
    {
      Type = "GroupBox",
      Position = { 0, 0 },
      Size = { 400, 100 },
      Fill = PanelGray,
      StrokeWidth = 0,
    },
  }
  -- Populate hidden controls using the SAME page functions, retaining stable pin names.
  SetupLayout(layout, {})
  CertificateLayout(layout, {})
  for channel = 1, props.Channels.Value do
    ChannelLayout(layout, {}, channel)
  end
  -- Button-specific fields can make hidden controls appear in Designer 10.5.
  for name, item in pairs(layout) do
    layout[name] = {
      Style = "None",
      Position = item.Position,
      Size = item.Size,
      PrettyName = item.PrettyName,
    }
  end
  if page == 1 then
    SetupLayout(layout, graphics)
  elseif certificatePage then
    CertificateLayout(layout, graphics)
  else
    ChannelLayout(layout, graphics, page - 1)
  end
  table.insert(graphics, {
    Type = "Svg",
    Image = MqttLogo,
    Position = { 12.5, 25 / 11 },
    Size = { 375, 1050 / 11 },
  })
  table.insert(graphics, {
    Type = "Label",
    Text = page == 1 and "Setup"
      or (certificatePage and "Certificates" or "Channel " .. (page - 1)),
    Position = { 7, 106 },
    Size = { 380, 22 },
    Color = Black,
    FontSize = 20,
    FontStyle = "Medium",
    HTextAlign = "Left",
  })
  table.insert(graphics, {
    Type = "Label",
    Text = "Version " .. PluginInfo.Version,
    Position = { 205, height - 22 },
    Size = { 180, 16 },
    Color = Black,
    FontSize = 10,
    HTextAlign = "Right",
  })
  for index, item in ipairs(graphics) do
    item.ZOrder = index
    item.Font = "Roboto"
    if item.Type == "Header" then
      item.HTextAlign = "Center"
    end
  end
  local order = 1000
  for _, definition in ipairs(GetControls(props)) do
    local item = layout[definition.Name]
    item.ZOrder = order
    order = order + 1
  end
  return layout, graphics
end

